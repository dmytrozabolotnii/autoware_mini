<?xml version="1.0"?>
<launch>

    <arg name='map_name'                default='tartu_demo' />
    <arg name="lanelet2_map_name"       default="$(arg map_name).osm" />
    <arg name="max_speed"               default="40" />
    <arg name="localizer"               default="novatel"           doc="novatel, carla"/>
    <arg name="use_lidar_center"        default="true"              doc="use velodyne lidar"/>
    <arg name="use_lidar_front"         default="false"             doc="use ouster lidar"/>
    <arg name="detector"                default="lidar_cluster_fast" doc="lidar_cluster, lidar_cluster_fast, sim, carla"/>
    <arg name="tfl_detector"            default="mqtt_camera_fusion" doc="mqtt, camera, mqtt_camera_fusion" />
    <arg name="tfl_cameras"             default="mako"              doc="mako, nvidia" />
    <arg name="use_nvidia_cameras"      default="$(eval 'camera' in tfl_detector and tfl_cameras=='nvidia')" doc="use nvidia cameras" />
    <arg name="nvidia_encoder"          default="$(eval 'jpeg' if 'camera' in tfl_detector and tfl_cameras=='nvidia' else 'h264')" doc="h264, jpeg"/> 
    <arg name="tracker"                 default="ema"               doc="none, ema" />
    <arg name="predictor"               default="map_naive"         doc="none, naive, map, map_naive" />
    <arg name="controller"              default="pure_pursuit"      doc="pure_pursuit, stanley" />
    <arg name="global_planner"          default="lanelet2"          doc="waypoints, lanelet2" />
    <arg name="local_planner"           default="rule"              doc="none, rule, openpilot"/>
    <arg name="use_path_smoothing"      default="true" />
    <arg name="use_road_area_filter"    default="$(eval 'tartu' in map_name)"   doc="use road area filter"/>
    <arg name="waypoints_file"          default="waypoints_erm_utm_1m.csv" />
    <arg name="detection_range"         default=""                  doc="enter a value in meters to enable it" />
    <arg name="more_visualizations"     default="false"             doc="By default visualize only the final detections" />
    <arg name="use_lane_matching"       default="false" />
    <arg name="use_openpilot_predictions" default="$(eval 'openpilot' in local_planner or use_lane_matching)" />
    <arg name="use_openpilot_road_camera"   default="false"  />
    <arg name="use_openpilot_wide_camera"   default="false"  />
    <arg name="use_openpilot_driver_camera" default="false"  />
    <arg name="use_openpilot_qroad_camera"  default="true"  />
    <arg name="blacklist_file"          default="$(find autoware_mini)/config/record_bag/blacklist.txt" />
    <arg name="recorded_bags_dir"       default="/media/$(env USER)/ExtremePro/$(env USER)" />
    <arg name="enable_goal_checker"          default="true" />
    <arg name="enable_object_checker"        default="true" />
    <arg name="enable_auto_stop_checker"     default="true" />
    <arg name="enable_traffic_light_checker" default="true" />
    <arg name="enable_crosswalk_checker"     default="true" />
    <arg name="enable_yielding_checker"      default="true" />
    <arg name="enable_trajectory_checker"    default="true" />
    <arg name="ground_removal"          default="naive"         doc="naive, jcp" />
    <arg name="use_webapp"              default="true"          doc="Set to false to disable web app MQTT bridge node." />
    <arg name="bag_name"                default="recording"     doc="Name of recorded bag files when car buttons are used" />
    <arg name="launch_rviz"             default="true" />
    <arg name="session_id"              default=""              doc="Session ID for the webapp bridge" />
    
    <!-- Localization -->
    <include file="$(find autoware_mini)/launch/localization.launch">
        <arg name="localizer"           value="$(arg localizer)" />
        <arg name="map_name"            value="$(arg map_name)" />
        <arg name="use_lane_matching"   value="$(arg use_lane_matching)" />
    </include>

    <!-- Detection -->
    <include file="$(find autoware_mini)/launch/detection.launch">
        <arg name="use_lidar_center"    value="$(arg use_lidar_center)" />
        <arg name="use_lidar_front"     value="$(arg use_lidar_front)" />
        <arg name="detector"            value="$(arg detector)" />
        <arg name="tfl_detector"        value="$(arg tfl_detector)" />
        <arg name="tfl_cameras"         value="$(arg tfl_cameras)" />
        <arg name="lanelet2_map_name"   value="$(arg lanelet2_map_name)" />
        <arg name="tracker"             value="$(arg tracker)" />
        <arg name="predictor"           value="$(arg predictor)" />
        <arg name="more_visualizations" value="$(arg more_visualizations)" />
        <arg name="detection_range"     value="$(arg detection_range)" />
        <arg name="map_name"            value="$(arg map_name)" />
        <arg name="use_road_area_filter" value="$(arg use_road_area_filter)" />
        <arg name="ground_removal"      value="$(arg ground_removal)" />
    </include>

    <!-- Planning -->
    <include file="$(find autoware_mini)/launch/planning.launch">
        <arg name="global_planner"      value="$(arg global_planner)" />
        <arg name="local_planner"       value="$(arg local_planner)" />
        <arg name="use_path_smoothing"  value="$(arg use_path_smoothing)" />
        <arg name="waypoints_file"      value="$(arg waypoints_file)" />
        <arg name="lanelet2_map_name"   value="$(arg lanelet2_map_name)" />
        <arg name="map_name"            value="$(arg map_name)" />
        <arg name="enable_goal_checker"          value="$(arg enable_goal_checker)" />
        <arg name="enable_object_checker"        value="$(arg enable_object_checker)" />
        <arg name="enable_auto_stop_checker"     value="$(arg enable_auto_stop_checker)" />
        <arg name="enable_traffic_light_checker" value="$(arg enable_traffic_light_checker)" />
        <arg name="enable_crosswalk_checker"     value="$(arg enable_crosswalk_checker)" />
        <arg name="enable_yielding_checker"      value="$(arg enable_yielding_checker)" />
        <arg name="enable_trajectory_checker"    value="$(arg enable_trajectory_checker)" />
    </include>

    <!-- Control -->
    <include file="$(find autoware_mini)/launch/control.launch">
        <arg name="controller"            value="$(arg controller)" />
    </include>

    <!-- Vehicle -->
    <include file="$(find autoware_mini)/launch/platform/lexus.launch" >
        <arg name="max_speed"           value="$(arg max_speed)" />
        <arg name="use_lidar_center"    value="$(arg use_lidar_center)" />
        <arg name="use_lidar_front"     value="$(arg use_lidar_front)" />
        <arg name="use_camera_fl"       value="$(eval 'camera' in tfl_detector and tfl_cameras=='mako')" />
        <arg name="use_camera_fr"       value="$(eval 'camera' in tfl_detector and tfl_cameras=='mako')" />
        <arg name="use_nvidia_cameras"  value="$(arg use_nvidia_cameras)" />
        <arg name="nvidia_encoder"      value="$(arg nvidia_encoder)" />
        <arg name="use_radar_fc"        value="$(eval 'radar' in detector)" />
        <arg name="use_openpilot_predictions"   value="$(arg use_openpilot_predictions)" />
        <arg name="use_openpilot_road_camera"   value="$(arg use_openpilot_road_camera)" />
        <arg name="use_openpilot_wide_camera"   value="$(arg use_openpilot_wide_camera)" />
        <arg name="use_openpilot_driver_camera" value="$(arg use_openpilot_driver_camera)" />
        <arg name="use_openpilot_qroad_camera"  value="$(arg use_openpilot_qroad_camera)" />
    </include>

    <!-- Rviz -->
    <include if="$(arg launch_rviz)" file="$(find autoware_mini)/launch/rviz.launch">
        <arg name="driver_status"       value="true" />
    </include>

    <!-- Webapp bridge -->
    <include if="$(arg use_webapp)" file="$(find autoware_mini)/launch/tools/webapp.launch">
        <arg name="session_id" value="$(arg session_id)" />
    </include>

    <!-- Rosbag recording -->
    <node pkg="autoware_mini" type="record_bag.py" name="record_bag" output="screen" required="true" >
        <param name="blacklist_file"            value="$(arg blacklist_file)" />
        <param name="recorded_bags_dir"         value="$(arg recorded_bags_dir)" />
        <param name="bag_name"                  value="$(arg bag_name)"/>
    </node>

</launch>
