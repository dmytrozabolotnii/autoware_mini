<?xml version="1.0"?>
<launch>

    <arg name="controller"              default="pure_pursuit"  doc="pure_pursuit, stanley" />
    <arg name="global_planner"          default="lanelet2"      doc="waypoints, lanelet2" />
    <arg name="local_planner"           default="rule"          doc="rule, none" />
    <arg name="use_path_smoothing"      default="true" />
    <arg name="waypoints_file"          default="waypoints_erm_utm_1m.csv" />
    <arg name="scenario_name"           default=""              doc="scenario name" />
    <arg name='map_name'                default="$(eval 'tartu_demo_noheight' if scenario_name == '' else 'tartu_demo')" />
    <arg name="lanelet2_map_name"       default="$(arg map_name).osm" />
    <arg name="detector"                default="$(eval 'sim' if scenario_name == '' else 'none')" />
    <arg name="use_road_area_filter"    default="$(eval 'tartu' in map_name)"   doc="use road area filter"/>
    <arg name="tfl_detector"            default="none"          doc="mqtt" />
    <arg name="tracker"                 default="$(eval 'ema' if scenario_name != '' else 'none')"  doc="none, ema"/>
    <arg name="predictor"               default="$(eval 'map_naive' if scenario_name != '' else 'none')"  doc="none, naive, map, map_naive"/>
    <arg name="detection_range"         default=""              doc="enter a value in meters to enable it" />
    <arg name="launch_rviz"             default="true"          doc="Determines if rviz is launched or not. Rviz will be launched by default." />
    <arg name="rate"                    default="1"             doc="Scenario bag playback speed" />
    <arg name="enable_goal_checker"          default="true" />
    <arg name="enable_object_checker"        default="true" />
    <arg name="enable_auto_stop_checker"     default="false" />
    <arg name="enable_traffic_light_checker" default="true" />
    <arg name="enable_crosswalk_checker"     default="true" />
    <arg name="enable_yielding_checker"      default="true" />
    <arg name="enable_trajectory_checker"    default="true" />
    <arg name="use_webapp"                   default="false"         doc="Set to false to disable web app MQTT bridge node." />
    <arg name="ade_csv_file"                 default="" />
    <arg name="ade_threshold"                default="10" />
    <arg name="ade_plot_file"                default="" />
    <arg name="speed_smoothness_threshold"   default="1" />

    <!-- Localization -->
    <include file="$(find autoware_mini)/launch/localization.launch">
        <arg name="localizer"           value="simulation" />
        <arg name="map_name"            value="$(arg map_name)" />
    </include>

    <!-- Detection -->
    <include file="$(find autoware_mini)/launch/detection.launch">
        <arg name="detector"            value="$(arg detector)" />
        <arg name="tfl_detector"        value="$(arg tfl_detector)" />
        <arg name="lanelet2_map_name"   value="$(arg lanelet2_map_name)" />
        <arg name="tracker"             value="$(arg tracker)" />
        <arg name="predictor"           value="$(arg predictor)" />
        <arg name="detection_range"     value="$(arg detection_range)" />
        <arg name="map_name"            value="$(arg map_name)" />
        <arg name="use_road_area_filter" value="$(arg use_road_area_filter)" />
    </include>

    <!-- Planning -->
    <include file="$(find autoware_mini)/launch/planning.launch">
        <arg name="global_planner"      value="$(arg global_planner)" />
        <arg name="local_planner"       value="$(arg local_planner)" />
        <arg name="use_path_smoothing"  value="$(arg use_path_smoothing)" />
        <arg name="waypoints_file"      value="$(arg waypoints_file)" />
        <arg name="lanelet2_map_name"   value="$(arg lanelet2_map_name)" />
        <arg name="map_name"            value="$(arg map_name)" />
        <arg name="enable_goal_checker"          value="$(arg enable_goal_checker)" />
        <arg name="enable_object_checker"        value="$(arg enable_object_checker)" />
        <arg name="enable_auto_stop_checker"     value="$(arg enable_auto_stop_checker)" />
        <arg name="enable_traffic_light_checker" value="$(arg enable_traffic_light_checker)" />
        <arg name="enable_crosswalk_checker"     value="$(arg enable_crosswalk_checker)" />
        <arg name="enable_yielding_checker"      value="$(arg enable_yielding_checker)" />
        <arg name="enable_trajectory_checker"    value="$(arg enable_trajectory_checker)" />
    </include>

    <!-- Control -->
    <include file="$(find autoware_mini)/launch/control.launch">
        <arg name="controller"            value="$(arg controller)" />
    </include>

    <!-- Bicycle_model simulator -->
    <include file="$(find autoware_mini)/launch/platform/simulation.launch">
        <arg name="use_lexus_shadow"      value="$(eval scenario_name != '')" />
    </include>

    <!-- Rviz -->
    <group if="$(arg launch_rviz)">
        <include file="$(find autoware_mini)/launch/dashboard.launch" />
        <node type="rviz" name="rviz" pkg="rviz" args="-d $(find autoware_mini)/config/rviz/autoware_mini.rviz" required="true">
            <rosparam command="load" file="$(find autoware_mini)/config/rviz/actions.yaml"/>
        </node>
    </group>

    <!-- Webapp bridge -->
    <include if="$(arg use_webapp)" file="$(find autoware_mini)/launch/platform/webapp.launch" />

    <group if="$(eval scenario_name != '')">
        <!-- Play scenario bag -->
        <node pkg="rosbag" type="play" name="player" required="true" output="screen"
                args="$(find autoware_mini)/data/bag_scenarios/$(arg map_name)/$(arg scenario_name).bag --clock --queue=1 --rate=$(arg rate) --delay 2.5 --wait-for-subscribers" />

        <!-- Bag pausing button -->
        <node pkg="autoware_mini" type="pause_bag.py" name="pause_bag" output="screen" required="true"/>

        <!-- ADE calculation -->
        <node pkg="autoware_mini" type="scenario_metrics_calculator.py" name="scenario_metrics_calculator" output="screen" required="true" ns="vehicle">
            <param name="scenario_name" value="$(arg scenario_name)" />
            <param name="ade_threshold" value="$(arg ade_threshold)" />
            <param name="ade_csv_file" value="$(find autoware_mini)/$(arg ade_csv_file)" />
            <param name="ade_plot_file" value="$(find autoware_mini)/$(arg ade_plot_file)" />
            <param name="speed_smoothness_threshold" value="$(arg speed_smoothness_threshold)" />
        </node>

        <!-- Use simulation time from bag -->
        <param name="/use_sim_time" value="true" />
    </group>

</launch>